# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME=FinancialApp
APP_ENV=development
DEBUG=True
# Swagger en /docs (solo desarrollo)
ENABLE_DOCS=True
HOST=127.0.0.1
PORT=8000
TIMEZONE=America/Guayaquil

# ==============================================================================
# BASE DE DATOS (PostgreSQL con SQLAlchemy)
# Formato: postgresql+psycopg2://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# ==============================================================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/financial_db

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==============================================================================
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_esta_clave_secreta_por_una_segura_en_produccion_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# CORS: déjalo vacío salvo que otro sitio web llame a esta API (separados por comas)
# ==============================================================================
ALLOWED_ORIGINS=
