# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME=FinancialApp
APP_ENV=development
DEBUG=True
# Swagger en /docs (solo desarrollo)
ENABLE_DOCS=True
HOST=127.0.0.1
PORT=8000
TIMEZONE=America/Guayaquil

# ==============================================================================
# BASE DE DATOS (PostgreSQL con SQLAlchemy)
# Formato: postgresql+psycopg2://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# ==============================================================================
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/financial_db

# ==============================================================================
# SEGURIDAD Y AUTENTICACIÓN (JWT)
# ==============================================================================
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar_esta_clave_secreta_por_una_segura_en_produccion_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# CORS: déjalo vacío salvo que otro sitio web llame a esta API (separados por comas)
# ==============================================================================
ALLOWED_ORIGINS=

# ==============================================================================
# CORREO (recuperar contraseña). Vacío = desactivado.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación".
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Administración y sesiones
# ------------------------------------------------------------------------------
# Correos (separados por coma) con acceso al panel /admin. Sin esta variable nadie es administrador.
ADMIN_EMAILS=
# Duración de la sesión web: sin "mantener la sesión iniciada" (horas) y con ella (días)
SESSION_HOURS=12
SESSION_REMEMBER_DAYS=30
# Días que se guarda el registro de actividad de seguridad
SECURITY_EVENTS_RETENTION_DAYS=90
